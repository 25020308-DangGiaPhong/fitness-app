{
  "expo": {
    "name": "Fitness App",
    "slug": "fitness-app",
    "version": "0.1.0",
    "platforms": ["ios", "android"],
    "orientation": "default",
    "scheme": "fitnessapp",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "predictiveBackGestureEnabled": true
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5F3F0"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
