{
  "expo": {
    "name": "Fitness App",
    "slug": "fitness-app",
    "version": "0.1.0",
    "platforms": [
      "ios",
      "android"
    ],
    "orientation": "default",
    "scheme": "fitnessapp",
    "userInterfaceStyle": "light",
    "web": {
      "output": "server"
    },
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "predictiveBackGestureEnabled": true,
      "permissions": [
        "android.permission.CAMERA"
      ],
      "package": "com.sontobe.fitnessapp",
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5F3F0"
        }
      ],
      "expo-image",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow camera access for on-device pose tracking.",
          "recordAudioAndroid": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
